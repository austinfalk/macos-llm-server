+      UNR for (int j = 0; j < NDV; ++j) {
+        o_out[slot * DV + 8 * j + fn] = O[h][j].thread_elements()[0];
+        o_out[slot * DV + 8 * j + fn + 1] = O[h][j].thread_elements()[1];
+      }
+    }
+  }
+}
