+        \\  "head_dim": 128,
+        \\  "hidden_size": 2304,
+        \\  "intermediate_size": 6912,
+        \\  "num_attention_heads": 32,
+        \\  "num_hidden_layers": 5,
+        \\  "num_key_value_heads": 8,
+        \\  "rms_norm_eps": 1e-06,
+        \\  "rope_parameters": {"rope_theta": 10000.0},
