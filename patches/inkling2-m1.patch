+        O[h][j].thread_elements()[1] += t.thread_elements()[1];
+      }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+}
+if (sg == 0) {
+  UNR for (int h = 0; h < NHT; ++h) {
+    const int idx = int(fm) + 8 * h;
+    if (idx < M) {
+      const int r = idx / GQA;
+      const int gi = idx % GQA;
