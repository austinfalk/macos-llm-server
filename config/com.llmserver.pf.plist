<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/4-harden.sh. Loads pf-screensharing.conf at every
     boot: pf keeps no rules across a restart. -E enables pf with a reference,
     so it stays on alongside anything else of Apple's that uses it.
     The anchor, the configuration path and the log folder must match PF_ANCHOR,
     LLM_ETC and LLM_LOGS in scripts/lib.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.llmserver.pf</string>
	<key>ProgramArguments</key>
	<array>
		<string>/sbin/pfctl</string>
		<string>-E</string>
		<string>-a</string>
		<string>com.apple/250.llm-server</string>
		<string>-f</string>
		<string>/usr/local/etc/llm-server/pf-screensharing.conf</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/llm-server/pf.err.log</string>
</dict>
</plist>
